# Supabase — 값이 없으면 앱은 lib/seed.ts 목업 데이터로 동작합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 (관리자 검수 등). 클라이언트에 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=

# 카카오 로그인 (Supabase Auth Provider 설정에서 사용)
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=

# 카카오페이 결제 (서버 전용). 설정 시 결제창이 실제 카카오페이로 연결됩니다.
# 미설정 시 결제 페이지는 "데모 결제 완료"로 동작(가짜 카드창 아님).
KAKAOPAY_SECRET_KEY=
KAKAOPAY_CID=TC0ONETIME

# 심사용 테스트 회원 (Supabase 미설정 데모 모드에서 이메일 로그인).
# Supabase 운영 모드에선 Supabase Auth에 동일 계정을 만들어 사용하세요.
TEST_MEMBER_EMAIL=test@carini.demo
TEST_MEMBER_PASSWORD=carini1234
